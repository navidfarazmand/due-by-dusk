{
  "name": "due-by-dusk-harvest-edition",
  "version": "0.10.0",
  "private": true,
  "description": "Due by Dusk: Harvest Edition \u2014 Phaser 3 + TypeScript + Vite Engine Project",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:e2e": "vite build --mode e2e",
    "mobile:sync": "npm run build && cap sync",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "build:pc": "tsc --noEmit && vite build -c vite.pc.config.ts"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@fontsource/big-shoulders-stencil": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
